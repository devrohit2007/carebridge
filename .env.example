# CareBridge configuration. Copy to .env and edit:  cp .env.example .env
# Never commit .env. Never paste real keys into source files.

# --- Server -------------------------------------------------------------
PORT=8787
# 127.0.0.1 = this device only (safe default for Termux).
# Use 0.0.0.0 when deploying behind a host such as Render.
HOST=127.0.0.1
# Set to 1 when running behind a reverse proxy / PaaS so client IPs and HTTPS are read from X-Forwarded-* headers.
TRUST_PROXY=0

# --- AI provider --------------------------------------------------------
# gemini     = Google Gemini API (free tier available, key from https://aistudio.google.com/apikey)
# openai     = any OpenAI-compatible /chat/completions API (OpenAI, Groq, OpenRouter, Together, Ollama...)
# anthropic  = Anthropic Claude API
# none       = no AI: built-in rules engine only (works offline; limited accuracy)
# Leave AI_API_KEY empty and CareBridge runs in rules-only mode.
AI_PROVIDER=gemini
AI_API_KEY=
# Faster = lighter model: try AI_MODEL=gemini-flash-lite-latest (check with `npm run models`, time it with `npm run bench`).
# Model name. Defaults: gemini -> gemini-flash-latest, anthropic -> claude-haiku-4-5-20251001.
# Required for provider "openai". Model names change often: run `npm run models` to list what your key can use.
AI_MODEL=
# Only needed for "openai" (e.g. https://api.groq.com/openai/v1) or to override a default endpoint.
AI_BASE_URL=
# Speed: "off" (default) asks Gemini for the least thinking time (much faster). Use "default" to leave the model's own setting.
AI_THINKING=off
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=12000
# If the AI call fails, fall back to the rules engine instead of showing an error (true/false).
FALLBACK_TO_RULES=true

# --- Protection for a public demo ---------------------------------------
# If set, visitors must enter this code before any analysis runs. Protects your API quota.
ACCESS_CODE=
# Requests per IP per window for the analysis endpoints.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000

# --- Size limits --------------------------------------------------------
MAX_DOCS=10
MAX_PAGES_PER_DOC=60
MAX_CHARS_PER_DOC=60000
MAX_TOTAL_CHARS=150000
